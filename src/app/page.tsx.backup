}

// ============================================================
// ScoreGauge Component — Circular SVG gauge
// ============================================================

function ScoreGauge({ score, size = 120, strokeWidth = 8, label }: { score: number; size?: number; strokeWidth?: number; label?: string }) {
  const radius = (size - strokeWidth) / 2
  const circumference = 2 * Math.PI * radius
  const offset = circumference - (score / 10) * circumference
  const color = getScoreColor(score)
  const center = size / 2

  return (
    <div className="relative inline-flex items-center justify-center" style={{ width: size, height: size }}>
      <svg width={size} height={size} className="-rotate-90">
        <circle cx={center} cy={center} r={radius} fill="none" stroke="currentColor" strokeWidth={strokeWidth} className="text-slate-800" />
        <circle
          cx={center} cy={center} r={radius} fill="none"
          stroke={color} strokeWidth={strokeWidth}
          strokeDasharray={circumference} strokeDashoffset={offset}
          strokeLinecap="round"
          className="transition-all duration-1000 ease-out"
          style={{ filter: `drop-shadow(0 0 6px ${color}40)` }}
        />
      </svg>
      <div className="absolute inset-0 flex flex-col items-center justify-center">
        <span className="text-2xl font-bold" style={{ color }}>{score}</span>
        {label && <span className="text-[10px] text-slate-400 mt-0.5">{label}</span>}
      </div>
    </div>
  )
}

// ============================================================
// Mini ScoreGauge for cards
// ============================================================

function MiniScoreGauge({ score, size = 48 }: { score: number; size?: number }) {
  const strokeWidth = 4
  const radius = (size - strokeWidth) / 2
  const circumference = 2 * Math.PI * radius
  const offset = circumference - (score / 10) * circumference
  const color = getScoreColor(score)
  const center = size / 2

  return (
    <div className="relative inline-flex items-center justify-center" style={{ width: size, height: size }}>
      <svg width={size} height={size} className="-rotate-90">
        <circle cx={center} cy={center} r={radius} fill="none" stroke="currentColor" strokeWidth={strokeWidth} className="text-slate-700" />
        <circle cx={center} cy={center} r={radius} fill="none" stroke={color} strokeWidth={strokeWidth}
          strokeDasharray={circumference} strokeDashoffset={offset} strokeLinecap="round"
          className="transition-all duration-700 ease-out" />
      </svg>
      <span className="absolute text-xs font-bold" style={{ color }}>{score}</span>
    </div>
  )
}

// ============================================================
// AgentFlowPipeline — Animated horizontal pipeline
// ============================================================

function AgentFlowPipeline({ variant }: { variant: BuildVariant }) {
  const agents = variant.agents
  const agentIcons: Record<string, any> = {
    'Planner': Target, 'Research': Search, 'Memory': Database,
    'Execution': Zap, 'Output': Rocket, 'User': Users,
  }

  return (
    <div className="flex items-center justify-center gap-1 overflow-x-auto py-4 px-2">
      {/* User input */}
      <motion.div initial={{ opacity: 0, x: -20 }} animate={{ opacity: 1, x: 0 }} transition={{ delay: 0 }}
        className="flex flex-col items-center gap-1.5 min-w-[70px]">
        <div className="w-12 h-12 rounded-xl bg-gradient-to-br from-slate-600 to-slate-700 flex items-center justify-center shadow-lg border border-slate-500/30">
          <Users className="w-5 h-5 text-white" />
        </div>
        <span className="text-[10px] font-medium text-slate-400">User</span>
      </motion.div>

      <motion.div initial={{ opacity: 0, scaleX: 0 }} animate={{ opacity: 1, scaleX: 1 }} transition={{ delay: 0.2 }}
        className="w-8 h-0.5 bg-gradient-to-r from-slate-600 to-amber-600 shrink-0 origin-left" />

      {agents.map((agent, i) => {
        const Icon = agentIcons[agent.name] || Bot
        const colors = [
          'from-amber-500 to-orange-600', 'from-emerald-500 to-teal-600',
          'from-violet-500 to-purple-600', 'from-rose-500 to-red-600',
          'from-cyan-500 to-sky-600',
        ]
        const gradient = colors[i % colors.length]
        return (
          <React.Fragment key={agent.name}>
            <motion.div
              initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.3 + i * 0.15 }}
              className="flex flex-col items-center gap-1.5 min-w-[70px] group"
            >
              <Tooltip>
                <TooltipTrigger asChild>
                  <div className={`w-12 h-12 rounded-xl bg-gradient-to-br ${gradient} flex items-center justify-center shadow-lg border border-white/10 cursor-pointer
                    group-hover:scale-110 transition-transform`}>
                    <Icon className="w-5 h-5 text-white" />
                  </div>
                </TooltipTrigger>
                <TooltipContent side="bottom" className="max-w-[200px]">
                  <p className="font-semibold text-xs">{agent.name}</p>
                  <p className="text-[10px] text-slate-400">{agent.role}: {agent.description}</p>
                </TooltipContent>
              </Tooltip>
              <span className="text-[10px] font-medium text-slate-400 text-center">{agent.name}</span>
            </motion.div>
            {i < agents.length - 1 && (
              <motion.div initial={{ opacity: 0, scaleX: 0 }} animate={{ opacity: 1, scaleX: 1 }}
                transition={{ delay: 0.4 + i * 0.15 }}
                className="w-6 h-0.5 bg-gradient-to-r from-violet-600 to-indigo-600 shrink-0 origin-left" />
            )}
          </React.Fragment>
        )
      })}

      <motion.div initial={{ opacity: 0, scaleX: 0 }} animate={{ opacity: 1, scaleX: 1 }}
        transition={{ delay: 0.3 + agents.length * 0.15 }}
        className="w-8 h-0.5 bg-gradient-to-r from-emerald-600 to-emerald-500 shrink-0 origin-left" />

      <motion.div initial={{ opacity: 0, x: 20 }} animate={{ opacity: 1, x: 0 }}
        transition={{ delay: 0.4 + agents.length * 0.15 }}
        className="flex flex-col items-center gap-1.5 min-w-[70px]">
        <div className="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center shadow-lg border border-emerald-400/30">
          <Rocket className="w-5 h-5 text-white" />
        </div>
        <span className="text-[10px] font-medium text-emerald-400">Output</span>
      </motion.div>
    </div>
  )
}

// ============================================================
// ArchitectureDiagram — Layered CSS architecture blocks
// ============================================================

function ArchitectureDiagram({ architecture }: { architecture: ArchitectureBlock[] }) {
  const layers = useMemo(() => {
    const layerOrder = ['frontend', 'api', 'service', 'agent', 'memory', 'llm', 'data', 'infra', 'automation']
    return [...architecture].sort((a, b) => layerOrder.indexOf(a.type) - layerOrder.indexOf(b.type))
  }, [architecture])

  return (
    <div className="space-y-2">
      {layers.map((block, i) => (
        <motion.div
          key={block.id}
          initial={{ opacity: 0, x: -20 }}
          animate={{ opacity: 1, x: 0 }}
          transition={{ delay: i * 0.08 }}
          className={`relative p-3 rounded-lg border ${getArchBlockBgColor(block.type)} backdrop-blur-sm`}
        >
          <div className="flex items-center justify-between gap-3">
            <div className="flex items-center gap-2.5">
              <div className={`w-9 h-9 rounded-lg bg-gradient-to-br ${getArchBlockColor(block.type)} flex items-center justify-center shadow-sm`}>
                <span className="text-[10px] font-bold text-white">{block.label.slice(0, 3).toUpperCase()}</span>
              </div>
              <div>
                <span className="font-semibold text-sm text-white">{block.label}</span>
                <p className="text-[11px] text-slate-400">{block.description}</p>
              </div>
            </div>
            <Badge variant="outline" className="text-[10px] border-slate-600 text-slate-300 shrink-0">{block.technology}</Badge>
          </div>
          {block.connections.length > 0 && (
            <div className="mt-2 flex flex-wrap gap-1 ml-12">
              {block.connections.map((conn) => (
                <span key={conn} className="text-[9px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-500">→ {conn}</span>
              ))}
            </div>
          )}
        </motion.div>
      ))}
    </div>
  )
}

// ============================================================
// ScoreRadar — Recharts RadarChart for product scoring
// ============================================================

function ScoreRadar({ score }: { score: ProductScore }) {
  const data = [
    { metric: 'Market Demand', value: score.marketDemand, fullMark: 10 },
    { metric: 'Feasibility', value: score.technicalFeasibility, fullMark: 10 },
    { metric: 'Innovation', value: score.innovation, fullMark: 10 },
    { metric: 'Ecosystem', value: score.ecosystemMaturity, fullMark: 10 },
  ]

  const compNum = score.competition === 'low' ? 8 : score.competition === 'medium' ? 5 : 3
  data.push({ metric: 'Low Competition', value: compNum, fullMark: 10 })

  return (
    <ResponsiveContainer width="100%" height={280}>
      <RadarChart data={data} cx="50%" cy="50%" outerRadius="70%">
        <PolarGrid stroke="#334155" />
        <PolarAngleAxis dataKey="metric" tick={{ fill: '#94a3b8', fontSize: 10 }} />
        <PolarRadiusAxis angle={30} domain={[0, 10]} tick={{ fill: '#64748b', fontSize: 9 }} />
        <Radar name="Score" dataKey="value" stroke="#8b5cf6" fill="#8b5cf6" fillOpacity={0.2} strokeWidth={2} />
        <RechartsTooltip
          contentStyle={{ backgroundColor: '#1e293b', border: '1px solid #334155', borderRadius: '8px', fontSize: '12px' }}
          labelStyle={{ color: '#e2e8f0' }}
          itemStyle={{ color: '#8b5cf6' }}
        />
      </RadarChart>
    </ResponsiveContainer>
  )
}

// ============================================================
// SimulationChat — Chat-style input/output simulation
// ============================================================

function SimulationChat({ example }: { example: ExampleOutput }) {
  // Key-driven animation: parent passes key={example.input} to force remount on change
  const [stepIndex, setStepIndex] = useState(-1)
  const [showOutput, setShowOutput] = useState(false)

  useEffect(() => {
    let step = 0
    const interval = setInterval(() => {
      if (step >= example.steps.length) {
        clearInterval(interval)
        setShowOutput(true)
        return
      }
      step++
      setStepIndex(step)
    }, 800)
    return () => clearInterval(interval)
  }, [example.steps.length])

  return (
    <div className="rounded-xl border border-slate-700/50 bg-slate-900/80 backdrop-blur-sm overflow-hidden">
      {/* Input */}
      <div className="p-3 border-b border-slate-700/50 flex items-start gap-2.5">
        <div className="w-7 h-7 rounded-full bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center shrink-0 mt-0.5">
          <Users className="w-3.5 h-3.5 text-white" />
        </div>
        <div className="flex-1 min-w-0">
          <span className="text-[10px] text-emerald-400 font-medium">USER INPUT</span>
          <p className="text-sm text-slate-200 mt-0.5">{example.input}</p>
        </div>
      </div>

      {/* Processing Steps */}
      <div className="p-3 border-b border-slate-700/50 space-y-2">
        {example.steps.slice(0, stepIndex).map((step, i) => (
          <motion.div key={i} initial={{ opacity: 0, y: 5 }} animate={{ opacity: 1, y: 0 }}
            className="flex items-start gap-2.5">
            <div className="w-7 h-7 rounded-full bg-gradient-to-br from-violet-500 to-indigo-600 flex items-center justify-center shrink-0 mt-0.5">
              <Bot className="w-3.5 h-3.5 text-white" />
            </div>
            <div className="flex-1">
              <span className="text-[10px] text-violet-400 font-medium">STEP {i + 1}</span>
              <p className="text-sm text-slate-300 mt-0.5">{step}</p>
            </div>
          </motion.div>
        ))}
        {stepIndex < example.steps.length && (
          <div className="flex items-center gap-2 text-violet-400 text-xs">
            <Loader2 className="w-3 h-3 animate-spin" />
            <span>Processing...</span>
          </div>
        )}
      </div>

      {/* Output */}
      {showOutput && (
        <motion.div initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }}
          className="p-3 flex items-start gap-2.5">
          <div className="w-7 h-7 rounded-full bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center shrink-0 mt-0.5">
            <Sparkles className="w-3.5 h-3.5 text-white" />
          </div>
          <div className="flex-1">
            <span className="text-[10px] text-amber-400 font-medium">OUTPUT</span>
            <p className="text-sm text-slate-200 mt-0.5">{example.output}</p>
          </div>
        </motion.div>
      )}
    </div>
  )
}

// ============================================================
// MonetizationTimeline — Phase timeline with connecting line
// ============================================================

function MonetizationTimeline({ phases }: { phases: MonetizationPhase[] }) {
  const phaseColors = ['from-emerald-400 to-teal-500', 'from-blue-400 to-cyan-500', 'from-violet-400 to-purple-500', 'from-amber-400 to-orange-500']

  return (
    <div className="relative">
      {/* Connecting line */}
      <div className="absolute left-6 top-8 bottom-8 w-0.5 bg-gradient-to-b from-emerald-500 via-blue-500 via-violet-500 to-amber-500 hidden sm:block" />

      <div className="grid grid-cols-1 sm:grid-cols-4 gap-4 sm:gap-6">
        {phases.map((phase, i) => (
          <motion.div key={phase.phase}
            initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }}
            transition={{ delay: i * 0.15 }}
            className="relative"
          >
            {/* Dot on line */}
            <div className="hidden sm:flex absolute left-0 top-6 w-3 h-3 rounded-full bg-gradient-to-br ${phaseColors[i]} border-2 border-slate-900 z-10 -translate-x-[5px]" />

            <div className="sm:ml-6 p-4 rounded-xl border border-slate-700/50 bg-slate-800/50 backdrop-blur-sm">
              <div className="flex items-center gap-2 mb-2">
                <div className={`w-8 h-8 rounded-lg bg-gradient-to-br ${phaseColors[i % phaseColors.length]} flex items-center justify-center`}>
                  <span className="text-xs font-bold text-white">P{phase.phase}</span>
                </div>
                <div>
                  <span className="font-semibold text-sm text-white">{phase.label}</span>
                  <p className="text-[10px] text-slate-400">{phase.timeline}</p>
                </div>
              </div>
              <p className="text-xs text-slate-400 mb-2">{phase.description}</p>
              <div className="flex items-center gap-1">
                <DollarSign className="w-3.5 h-3.5 text-emerald-400" />
                <span className="text-sm font-semibold text-emerald-400">{phase.revenue}</span>
              </div>
            </div>
          </motion.div>
        ))}
      </div>
    </div>
  )
}

// ============================================================
// StickyBuildBar — Always-visible bottom action bar
// ============================================================

function StickyBuildBar({
  product, selectedTier, onExport, onGenerate, onBack, exporting
}: {
  product: ProductBuild
  selectedTier: string
  onExport: (product: ProductBuild, format: 'json' | 'yaml') => void
  onGenerate: (product: ProductBuild, variant: string) => void
  onBack: () => void
  exporting: boolean
}) {
  return (
    <motion.div
      initial={{ y: 80 }} animate={{ y: 0 }}
      className="fixed bottom-0 left-0 right-0 z-50 border-t border-slate-700/50 bg-slate-900/90 backdrop-blur-xl shadow-2xl"
    >
      <div className="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-3">
        <div className="flex items-center gap-3 min-w-0">
          <Button variant="ghost" size="sm" onClick={onBack} className="text-slate-400 hover:text-white shrink-0">
            <ArrowLeft className="w-4 h-4 mr-1" /> Back
          </Button>
          <div className="hidden sm:block truncate">
            <p className="font-semibold text-sm text-white truncate">{product.title}</p>
            <p className="text-[10px] text-slate-400">{selectedTier} tier</p>
          </div>
        </div>
        <div className="flex items-center gap-2">
          <Button size="sm" onClick={() => onGenerate(product, selectedTier)}
            className="bg-gradient-to-r from-violet-500 to-indigo-600 hover:from-violet-600 hover:to-indigo-700 text-white shadow-lg shadow-violet-500/20">
            <Rocket className="w-4 h-4 mr-1.5" /> Generate Starter Repo
          </Button>
          <Button variant="outline" size="sm" onClick={() => onExport(product, 'json')} disabled={exporting}
            className="border-slate-600 text-slate-300 hover:text-white hover:border-slate-500">
            <FileJson className="w-4 h-4 mr-1.5" /> JSON
          </Button>
          <Button variant="outline" size="sm" onClick={() => onExport(product, 'yaml')} disabled={exporting}
            className="border-slate-600 text-slate-300 hover:text-white hover:border-slate-500">
            <FileText className="w-4 h-4 mr-1.5" /> YAML
          </Button>
        </div>
      </div>
    </motion.div>
  )
}

// ============================================================
// RepoCard — Explorer tab repo card
// ============================================================

function RepoCard({ repo, selected, onToggleSelect, compact }: {
  repo: RepoData; selected: boolean; onToggleSelect: () => void; compact?: boolean
}) {
  return (
    <motion.div
      whileHover={{ scale: 1.02 }}
      className={`rounded-xl border backdrop-blur-sm transition-all cursor-pointer group
        ${selected
          ? 'border-violet-500/50 bg-violet-950/40 shadow-lg shadow-violet-500/10'
          : 'border-slate-700/50 bg-slate-800/40 hover:border-slate-600/50 hover:bg-slate-800/60'
        }`}
    >
      <div className={`${compact ? 'p-3' : 'p-4'} space-y-3`}>
        <div className="flex items-start justify-between gap-2">
          <div className="flex items-center gap-2 min-w-0">
            <img src={repo.ownerAvatar} alt={repo.owner} className="w-6 h-6 rounded-full shrink-0 ring-1 ring-slate-700" />
            <a href={repo.url} target="_blank" rel="noopener noreferrer"
              className="font-semibold text-sm truncate text-slate-200 hover:text-violet-400 transition-colors flex items-center gap-1">
              {repo.name}
              <ExternalLink className="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity shrink-0" />
            </a>
          </div>
          <Button variant="ghost" size="sm" className={`h-7 w-7 p-0 shrink-0 ${selected ? 'text-violet-400' : 'text-slate-500'}`} onClick={onToggleSelect}>
            {selected ? <CheckCircle2 className="w-4 h-4" /> : <Bookmark className="w-4 h-4" />}
          </Button>
        </div>
        {repo.description && <p className="text-xs text-slate-400 line-clamp-2">{repo.description}</p>}
        <div className="flex flex-wrap gap-1.5">
          <Badge variant="secondary" className="text-xs h-5 bg-slate-700/50 text-slate-300 border-0">
            <Star className="w-3 h-3 mr-0.5 text-amber-400" />{formatStars(repo.stars)}
          </Badge>
          <Badge variant="secondary" className="text-xs h-5 bg-slate-700/50 text-slate-300 border-0">
            <GitFork className="w-3 h-3 mr-0.5" />{formatStars(repo.forks)}
          </Badge>
          {repo.language && (
            <Badge className="text-xs h-5 border-0" style={{ backgroundColor: languageColors[repo.language] + '30', color: languageColors[repo.language] }} variant="outline">
              {repo.language}
            </Badge>
          )}
          <Badge className={`${getCategoryColor(repo.category)} text-xs h-5`}>{repo.category}</Badge>
        </div>
        {repo.innovationSignals.length > 0 && (
          <div className="flex flex-wrap gap-1">
            {repo.innovationSignals.slice(0, 2).map((signal) => (
              <span key={signal} className="text-[10px] text-violet-400 flex items-center gap-0.5">
                <Zap className="w-2.5 h-2.5" />{signal}
              </span>
            ))}
          </div>
        )}
      </div>
    </motion.div>
  )
}

// ============================================================
// Enhanced ProductCard — Preview card with hover effects
// ============================================================

function ProductCard({ product, onSelect }: { product: ProductBuild; onSelect: () => void }) {
  const defaultTier = product.buildVariants[1] || product.buildVariants[0]

  return (
    <motion.div
      whileHover={{ scale: 1.02, y: -4 }}
      whileTap={{ scale: 0.98 }}
      onClick={onSelect}
      className="rounded-xl border border-slate-700/50 bg-slate-800/50 backdrop-blur-sm cursor-pointer group
        hover:border-violet-500/30 hover:shadow-xl hover:shadow-violet-500/5 transition-all overflow-hidden"
    >
      <div className="p-5 space-y-4">
        {/* Header with Score */}
        <div className="flex items-start justify-between gap-3">
          <div className="flex-1 min-w-0">
            <h3 className="font-bold text-lg text-white truncate">{product.title}</h3>
            <p className="text-sm text-slate-400 mt-0.5">{product.tagline}</p>
          </div>
          <MiniScoreGauge score={product.productScore.finalScore} />
        </div>

        {/* Build Complexity Badge */}
        <div className="flex items-center gap-2">
          {product.buildVariants.map((variant) => {
            const tierStyle = getTierColor(variant.tier)
            return (
              <div key={variant.tier} className={`flex items-center gap-1.5 px-2 py-1 rounded-md text-xs ${tierStyle.badge}`}>
                <div className={`w-1.5 h-1.5 rounded-full ${tierStyle.dot}`} />
                {variant.tier === 'simple' ? 'MVP' : variant.tier === 'intermediate' ? 'Scalable' : 'Advanced'}
              </div>
            )
          })}
        </div>

        {/* Key Capabilities */}
        <div className="flex flex-wrap gap-1.5">
          {product.capabilities.slice(0, 4).map((cap) => {
            const CapIcon = getCapabilityIcon(cap.category)
            return (
              <Badge key={cap.category} className={`${getCapabilityBgColor(cap.category)} border text-xs`}>
                <CapIcon className="w-3 h-3 mr-1" />
                {cap.label}
              </Badge>
            )
          })}
        </div>

        {/* Hover Preview */}
        <div className="opacity-0 group-hover:opacity-100 transition-opacity duration-300 space-y-2 pt-2 border-t border-slate-700/30">
          <div className="flex items-center justify-between text-xs text-slate-400">
            <span className="flex items-center gap-1"><Github className="w-3 h-3" /> {defaultTier.repos.length} repos</span>
            <span className="flex items-center gap-1"><Bot className="w-3 h-3" /> {defaultTier.agents.length} agents</span>
            <span className="flex items-center gap-1"><Timer className="w-3 h-3" /> {defaultTier.estimatedTime}</span>
          </div>
          <div className="text-[10px] text-slate-500 line-clamp-2">{defaultTier.description}</div>
        </div>

        {/* CTA */}
        <div className="flex items-center justify-between">
          <div className="flex gap-2">
            <div className="text-center">
              <p className="text-[10px] text-slate-500">Demand</p>
              <p className="font-bold text-sm text-white">{product.productScore.marketDemand}</p>
            </div>
            <div className="text-center">
              <p className="text-[10px] text-slate-500">Innovation</p>
              <p className="font-bold text-sm text-white">{product.productScore.innovation}</p>
            </div>
            <div className="text-center">
              <p className="text-[10px] text-slate-500">Feasibility</p>
              <p className="font-bold text-sm text-white">{product.productScore.technicalFeasibility}</p>
            </div>
          </div>
          <div className="flex items-center gap-1 text-violet-400 text-xs font-medium group-hover:text-violet-300 transition-colors">
            View System <ChevronRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </div>
        </div>
      </div>
    </motion.div>
  )
}

// ============================================================
// Full System View — Complete product view (NOT modal)
// ============================================================

function FullSystemView({
  product, selectedTier, onTierChange, onExport, onGenerate, onBack, exporting, capabilities
}: {
  product: ProductBuild
  selectedTier: 'simple' | 'intermediate' | 'advanced'
  onTierChange: (tier: 'simple' | 'intermediate' | 'advanced') => void
  onExport: (product: ProductBuild, format: 'json' | 'yaml') => void
  onGenerate: (product: ProductBuild, variant: string) => void
  onBack: () => void
  exporting: boolean
  capabilities: Capability[]
}) {
  const variant = product.buildVariants.find(v => v.tier === selectedTier) || product.buildVariants[1] || product.buildVariants[0]
  const [archTab, setArchTab] = useState('visual')

  // Build repo graph nodes/edges
  const repoFlowNodes: Node[] = useMemo(() => {
    const nodes: Node[] = []
    let yOffset = 0
    product.capabilities.forEach((cap, capIdx) => {
      const angle = (capIdx / product.capabilities.length) * Math.PI * 2
      const centerX = 400
      const centerY = 300
      const radiusX = 250
      const radiusY = 200
      const capX = centerX + Math.cos(angle) * radiusX * 0.3
      const capY = centerY + Math.sin(angle) * radiusY * 0.3

      // Capability center node
      nodes.push({
        id: `cap-${cap.category}`,
        type: 'repoFlow',
        position: { x: capX, y: capY },
        data: { label: cap.label, repoCategory: cap.category, repoRole: 'Hub' },
      })

      cap.repos.forEach((repo, repoIdx) => {
        const repoAngle = angle + (repoIdx - cap.repos.length / 2) * 0.4
        const repoX = centerX + Math.cos(repoAngle) * radiusX
        const repoY = centerY + Math.sin(repoAngle) * radiusY
        nodes.push({
          id: `repo-${repo.fullName}`,
          type: 'repoFlow',
          position: { x: repoX, y: repoY },
          data: { label: repo.name, repoCategory: cap.category, repoRole: repo.role },
        })
      })
    })
    return nodes
  }, [product.capabilities])

  const repoFlowEdges: Edge[] = useMemo(() => {
    const edges: Edge[] = []
    product.capabilities.forEach((cap) => {
      cap.repos.forEach((repo) => {
        edges.push({
          id: `edge-${cap.category}-${repo.fullName}`,
          source: `cap-${cap.category}`,
          target: `repo-${repo.fullName}`,
          type: 'smoothstep',
          animated: true,
          style: { stroke: getNodeColor(cap.category === 'memory' ? 'capability' : 'repo'), strokeWidth: 1.5 },
        })
      })
      // Connect capabilities to each other
    })
    // Connect first capability to product
    if (product.capabilities.length > 0) {
      product.capabilities.slice(1).forEach((cap) => {
        edges.push({
          id: `edge-cap-${product.capabilities[0].category}-${cap.category}`,
          source: `cap-${product.capabilities[0].category}`,
          target: `cap-${cap.category}`,
          type: 'smoothstep',
          style: { stroke: '#6366f1', strokeWidth: 1, strokeDasharray: '4 4' },
        })
      })
    }
    return edges
  }, [product.capabilities])

  return (
    <div className="pb-20">
      {/* SECTION 1: SYSTEM OVERVIEW (HERO) */}
      <motion.section initial={{ opacity: 0 }} animate={{ opacity: 1 }} transition={{ duration: 0.5 }}
        className="relative overflow-hidden rounded-2xl border border-slate-700/50 bg-gradient-to-br from-slate-900 via-slate-800 to-violet-950/30 p-6 sm:p-8"
      >
        <div className="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-violet-600/5 via-transparent to-transparent" />
        <div className="relative flex flex-col sm:flex-row items-start sm:items-center gap-6">
          {/* Left: Product info + Score */}
          <div className="flex-1 min-w-0">
            <div className="flex items-center gap-2 mb-2">
              <Badge className="bg-violet-500/20 text-violet-300 border-violet-500/30 text-xs">
                <Sparkles className="w-3 h-3 mr-1" /> AI Product
              </Badge>
              <Badge className={`${getTierColor(selectedTier).badge} text-xs`}>
                <div className={`w-1.5 h-1.5 rounded-full ${getTierColor(selectedTier).dot} mr-1.5`} />
                {selectedTier === 'simple' ? 'MVP' : selectedTier === 'intermediate' ? 'Scalable' : 'Advanced AI System'}
              </Badge>
            </div>
            <h1 className="text-2xl sm:text-3xl font-bold text-white mb-2">{product.title}</h1>
            <p className="text-base text-slate-400 mb-4">{product.tagline}</p>
            <div className="grid grid-cols-2 gap-3 max-w-md">
              <div className="p-2.5 rounded-lg bg-slate-800/50 border border-slate-700/30">
                <p className="text-[10px] text-slate-500 uppercase tracking-wider">Audience</p>
                <p className="text-xs text-slate-300 mt-0.5">{product.targetAudience}</p>
              </div>
              <div className="p-2.5 rounded-lg bg-slate-800/50 border border-slate-700/30">
                <p className="text-[10px] text-slate-500 uppercase tracking-wider">Unique Value</p>
                <p className="text-xs text-slate-300 mt-0.5">{product.uniqueValue}</p>
              </div>
            </div>
          </div>
          {/* Right: Score Gauge */}
          <div className="flex flex-col items-center gap-2">
            <ScoreGauge score={product.productScore.finalScore} size={130} label="Overall Score" />
            <div className="flex items-center gap-1 text-xs text-slate-400">
              <span>Competition:</span>
              <Badge className={`text-[10px] h-4 ${product.productScore.competition === 'low' ? 'bg-emerald-900/50 text-emerald-300' : product.productScore.competition === 'medium' ? 'bg-amber-900/50 text-amber-300' : 'bg-rose-900/50 text-rose-300'}`}>
                {product.productScore.competition}
              </Badge>
            </div>
          </div>
        </div>
      </motion.section>

      <div className="mt-6 space-y-6">
        {/* SECTION 2: AGENT FLOW VISUALIZATION */}
        <motion.section initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.1 }}
          className="rounded-xl border border-slate-700/50 bg-slate-800/40 backdrop-blur-sm p-5"
        >
          <h3 className="text-sm font-semibold text-slate-300 mb-4 flex items-center gap-2">
            <Bot className="w-4 h-4 text-violet-400" /> Agent Flow Pipeline
          </h3>
          <AgentFlowPipeline variant={variant} />
        </motion.section>

        {/* SECTION 3: GITHUB COMPOSITION ENGINE */}
        <motion.section initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.2 }}
          className="rounded-xl border border-slate-700/50 bg-slate-800/40 backdrop-blur-sm overflow-hidden"
        >
          <div className="p-5 pb-3">
            <h3 className="text-sm font-semibold text-slate-300 flex items-center gap-2">
              <Github className="w-4 h-4 text-blue-400" /> GitHub Composition Engine
            </h3>
            <p className="text-xs text-slate-500 mt-1">Interactive repo graph — nodes colored by capability category</p>
          </div>
          <div className="h-[400px]">
            <ReactFlow nodes={repoFlowNodes} edges={repoFlowEdges} nodeTypes={nodeTypes} fitView minZoom={0.3} maxZoom={2}
              proOptions={{ hideAttribution: true }}>
              <Background color="#334155" gap={20} />
              <Controls className="!bg-slate-800 !border-slate-700 [&>button]:!bg-slate-800 [&>button]:!border-slate-700 [&>button]:!text-slate-300 [&>button:hover]:!bg-slate-700" />
            </ReactFlow>
          </div>
        </motion.section>

        {/* SECTION 4: ARCHITECTURE VIEW (TABBED) */}
        <motion.section initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }}
          className="rounded-xl border border-slate-700/50 bg-slate-800/40 backdrop-blur-sm p-5"
        >
          <h3 className="text-sm font-semibold text-slate-300 mb-3 flex items-center gap-2">
            <Box className="w-4 h-4 text-indigo-400" /> Architecture View
          </h3>
          <Tabs value={archTab} onValueChange={setArchTab}>
            <TabsList className="bg-slate-900/50 border border-slate-700/50">
              <TabsTrigger value="visual" className="text-xs">Visual Diagram</TabsTrigger>
              <TabsTrigger value="stack" className="text-xs">Layered Stack</TabsTrigger>
            </TabsList>
            <TabsContent value="visual" className="mt-4">
              <ArchitectureDiagram architecture={variant.architecture} />
            </TabsContent>
            <TabsContent value="stack" className="mt-4">
              <div className="space-y-2">
                {variant.techStack.map((tech, i) => {
                  const layerIcons: Record<string, any> = {
                    'Frontend': Palette, 'Backend': Server, 'Agent': Bot,
                    'Memory': Database, 'LLM': Brain, 'Infra': Globe,
                    'Data': BarChart3, 'API': Code2, 'Services': Workflow,
                  }
                  const Icon = layerIcons[tech.layer] || Package
                  const layerColors: Record<string, string> = {
                    'Frontend': 'border-sky-500/30 bg-sky-500/5', 'Backend': 'border-emerald-500/30 bg-emerald-500/5',
                    'Agent': 'border-amber-500/30 bg-amber-500/5', 'Memory': 'border-violet-500/30 bg-violet-500/5',
                    'LLM': 'border-indigo-500/30 bg-indigo-500/5', 'Infra': 'border-slate-500/30 bg-slate-500/5',
                    'Data': 'border-orange-500/30 bg-orange-500/5', 'API': 'border-cyan-500/30 bg-cyan-500/5',
                    'Services': 'border-rose-500/30 bg-rose-500/5',
                  }
                  return (
                    <motion.div key={tech.layer} initial={{ opacity: 0, x: -10 }} animate={{ opacity: 1, x: 0 }}
                      transition={{ delay: i * 0.05 }}
                      className={`flex items-center gap-3 p-3 rounded-lg border ${layerColors[tech.layer] || 'border-slate-700/30 bg-slate-800/30'}`}>
                      <Icon className="w-4 h-4 text-slate-400 shrink-0" />
                      <span className="text-xs font-semibold text-slate-400 w-20 shrink-0">{tech.layer}</span>
                      <div className="flex flex-wrap gap-1.5">
                        {tech.technologies.map((t) => (
                          <Badge key={t} variant="outline" className="text-[10px] h-5 border-slate-600/50 text-slate-300">{t}</Badge>
                        ))}
                      </div>
                    </motion.div>
                  )
                })}
              </div>
            </TabsContent>
          </Tabs>
        </motion.section>

        {/* SECTION 5: BUILD VARIANTS SWITCHER */}
        <motion.section initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.35 }}
          className="rounded-xl border border-slate-700/50 bg-slate-800/40 backdrop-blur-sm p-5"
        >
          <h3 className="text-sm font-semibold text-slate-300 mb-3 flex items-center gap-2">
            <Layers className="w-4 h-4 text-amber-400" /> Build Variants
          </h3>
          <div className="grid grid-cols-3 gap-3">
            {product.buildVariants.map((bv) => {
              const tierStyle = getTierColor(bv.tier)
              const isSelected = selectedTier === bv.tier
              return (
                <button key={bv.tier} onClick={() => onTierChange(bv.tier)}
                  className={`p-3 rounded-lg border-2 text-left transition-all ${
                    isSelected
                      ? `${tierStyle.border} ${tierStyle.bg} ring-1 ring-offset-1 ring-offset-slate-900 ring-violet-400/50`
                      : 'border-slate-700/50 bg-slate-900/30 hover:border-slate-600/50'
                  }`}>
                  <div className="flex items-center gap-2 mb-1">
                    <div className={`w-2.5 h-2.5 rounded-full ${tierStyle.dot}`} />
                    <span className="font-semibold text-sm text-white">
                      {bv.tier === 'simple' ? '🟢 MVP' : bv.tier === 'intermediate' ? '🟡 Scalable' : '🔴 Advanced AI System'}
                    </span>
                  </div>
                  <p className="text-[11px] text-slate-400 line-clamp-2">{bv.description}</p>
                  <div className="mt-2 flex items-center gap-2 text-[10px] text-slate-500">
                    <span>{bv.repos.length} repos</span>
                    <span>·</span>
                    <span>{bv.agents.length} agents</span>
                    <span>·</span>
                    <span>{bv.estimatedTime}</span>
                  </div>
                </button>
              )
            })}
          </div>
        </motion.section>

        {/* SECTION 6: PRODUCT SCORE */}
        <motion.section initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.4 }}
          className="rounded-xl border border-slate-700/50 bg-slate-800/40 backdrop-blur-sm p-5"
        >
          <h3 className="text-sm font-semibold text-slate-300 mb-3 flex items-center gap-2">
            <Target className="w-4 h-4 text-cyan-400" /> Product Score
          </h3>
          <div className="flex flex-col sm:flex-row items-center gap-6">
            <div className="flex-shrink-0">
              <ScoreRadar score={product.productScore} />
            </div>
            <div className="flex-1 space-y-3 w-full">
              {[
                { label: 'Market Demand', value: product.productScore.marketDemand },
                { label: 'Technical Feasibility', value: product.productScore.technicalFeasibility },
                { label: 'Innovation', value: product.productScore.innovation },
                { label: 'Ecosystem Maturity', value: product.productScore.ecosystemMaturity },
              ].map((item) => (
                <div key={item.label}>
                  <div className="flex items-center justify-between text-xs mb-1">
                    <span className="text-slate-400">{item.label}</span>
                    <span className="font-bold text-white">{item.value}/10</span>
                  </div>
                  <div className="h-2 rounded-full bg-slate-700/50 overflow-hidden">
                    <motion.div
                      initial={{ width: 0 }} animate={{ width: `${item.value * 10}%` }}
                      transition={{ duration: 0.8, delay: 0.2 }}
                      className="h-full rounded-full bg-gradient-to-r from-violet-500 to-indigo-500"
                      style={{ boxShadow: '0 0 8px rgba(139, 92, 246, 0.3)' }}
