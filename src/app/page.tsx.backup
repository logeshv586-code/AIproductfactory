function CustomFlowNode({ data }: NodeProps) {
  const nodeTypeColors: Record<string, string> = {
    repo: 'border-blue-500/50 bg-blue-950/80 backdrop-blur-sm',
    capability: 'border-violet-500/50 bg-violet-950/80 backdrop-blur-sm',
    product: 'border-emerald-500/50 bg-emerald-950/80 backdrop-blur-sm',
    tech: 'border-cyan-500/50 bg-cyan-950/80 backdrop-blur-sm',
    category: 'border-amber-500/50 bg-amber-950/80 backdrop-blur-sm',
  }
  const nodeTypeIcons: Record<string, any> = {
    repo: Github, capability: Layers, product: Rocket, tech: Code2, category: Tag,
  }
  const Icon = nodeTypeIcons[data.nodeType as string] || Box

  return (
    <div className={`px-3 py-2 rounded-lg border shadow-lg min-w-[100px] ${nodeTypeColors[data.nodeType as string] || 'border-gray-400 bg-gray-900/80'}`}>
      <Handle type="target" position={Position.Top} className="!bg-slate-400 !w-2 !h-2" />
      <div className="flex items-center gap-1.5">
        <Icon className="w-3.5 h-3.5 text-slate-300 shrink-0" />
        <span className="text-xs font-medium text-slate-200 truncate max-w-[120px]">{data.label as string}</span>
      </div>
      <Handle type="source" position={Position.Bottom} className="!bg-slate-400 !w-2 !h-2" />
    </div>
  )
}

// Stable icon renderer for repo flow nodes
