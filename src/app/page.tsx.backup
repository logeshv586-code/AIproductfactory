                  </div>
                </div>
              ))}
            </div>
          </div>
        </motion.section>

        {/* SECTION 7: LIVE SIMULATION */}
        <motion.section initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.45 }}
          className="rounded-xl border border-slate-700/50 bg-slate-800/40 backdrop-blur-sm p-5"
