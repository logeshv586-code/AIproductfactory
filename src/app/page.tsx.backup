          <h3 className="text-sm font-semibold text-slate-300 mb-3 flex items-center gap-2">
            <Play className="w-4 h-4 text-amber-400" /> Live Simulation
          </h3>
          <SimulationChat example={product.exampleOutput} key={product.exampleOutput.input} />
        </motion.section>

        {/* SECTION 8: AGENT ROLES */}
        <motion.section initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.5 }}
          className="rounded-xl border border-slate-700/50 bg-slate-800/40 backdrop-blur-sm p-5"
        >
          <h3 className="text-sm font-semibold text-slate-300 mb-3 flex items-center gap-2">
            <Bot className="w-4 h-4 text-violet-400" /> Agent Roles
          </h3>
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
            {variant.agents.map((agent, i) => {
              const agentColors = [
                'from-amber-500/20 to-orange-500/20 border-amber-500/30',
                'from-emerald-500/20 to-teal-500/20 border-emerald-500/30',
                'from-violet-500/20 to-purple-500/20 border-violet-500/30',
                'from-rose-500/20 to-red-500/20 border-rose-500/30',
              ]
              const iconColors = ['text-amber-400', 'text-emerald-400', 'text-violet-400', 'text-rose-400']
              const agentIcons: Record<string, any> = {
                'Planner': Target, 'Research': Search, 'Memory': Database,
                'Execution': Zap, 'Output': Rocket,
              }
              const Icon = agentIcons[agent.name] || Bot
              return (
                <motion.div key={agent.name} initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }}
                  transition={{ delay: 0.5 + i * 0.1 }}
                  className={`p-4 rounded-xl border bg-gradient-to-br ${agentColors[i % agentColors.length]}`}>
                  <div className="flex items-center gap-2.5 mb-2">
                    <div className={`w-8 h-8 rounded-lg bg-slate-800/80 flex items-center justify-center`}>
                      <Icon className={`w-4 h-4 ${iconColors[i % iconColors.length]}`} />
                    </div>
                    <div>
                      <span className="font-semibold text-sm text-white">{agent.name}</span>
                      <p className="text-[10px] text-slate-500">{agent.role}</p>
                    </div>
                  </div>
                  <p className="text-xs text-slate-400">{agent.description}</p>
                </motion.div>
              )
            })}
          </div>
        </motion.section>

        {/* SECTION 9: TECH STACK (LAYERED) */}
        <motion.section initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.55 }}
          className="rounded-xl border border-slate-700/50 bg-slate-800/40 backdrop-blur-sm p-5"
        >
          <h3 className="text-sm font-semibold text-slate-300 mb-3 flex items-center gap-2">
            <Code2 className="w-4 h-4 text-green-400" /> Tech Stack
          </h3>
          <div className="space-y-2">
            {variant.techStack.map((tech) => {
              const layerColors: Record<string, string> = {
                'Frontend': 'border-sky-500/20 bg-sky-500/5', 'Backend': 'border-emerald-500/20 bg-emerald-500/5',
                'Agent': 'border-amber-500/20 bg-amber-500/5', 'Memory': 'border-violet-500/20 bg-violet-500/5',
                'LLM': 'border-indigo-500/20 bg-indigo-500/5', 'Infra': 'border-slate-500/20 bg-slate-500/5',
                'Data': 'border-orange-500/20 bg-orange-500/5', 'API': 'border-cyan-500/20 bg-cyan-500/5',
                'Services': 'border-rose-500/20 bg-rose-500/5',
              }
              const labelColors: Record<string, string> = {
                'Frontend': 'text-sky-400', 'Backend': 'text-emerald-400', 'Agent': 'text-amber-400',
                'Memory': 'text-violet-400', 'LLM': 'text-indigo-400', 'Infra': 'text-slate-400',
                'Data': 'text-orange-400', 'API': 'text-cyan-400', 'Services': 'text-rose-400',
              }
              return (
                <div key={tech.layer} className={`flex items-center gap-3 p-2.5 rounded-lg border ${layerColors[tech.layer] || 'border-slate-700/20 bg-slate-800/20'}`}>
                  <span className={`text-xs font-semibold w-20 shrink-0 ${labelColors[tech.layer] || 'text-slate-400'}`}>{tech.layer}</span>
                  <Separator orientation="vertical" className="h-4 bg-slate-700/50" />
                  <div className="flex flex-wrap gap-1.5">
                    {tech.technologies.map((t) => (
                      <Badge key={t} variant="outline" className="text-[10px] h-5 border-slate-600/50 text-slate-300">{t}</Badge>
                    ))}
                  </div>
                </div>
              )
            })}
          </div>
        </motion.section>

        {/* SECTION 10: MONETIZATION ROADMAP */}
        <motion.section initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.6 }}
          className="rounded-xl border border-slate-700/50 bg-slate-800/40 backdrop-blur-sm p-5"
        >
          <h3 className="text-sm font-semibold text-slate-300 mb-4 flex items-center gap-2">
            <DollarSign className="w-4 h-4 text-emerald-400" /> Monetization Roadmap
          </h3>
          <MonetizationTimeline phases={product.monetization} />
        </motion.section>

        {/* SECTION: Key Features */}
        <motion.section initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.65 }}
          className="rounded-xl border border-slate-700/50 bg-slate-800/40 backdrop-blur-sm p-5"
        >
          <h3 className="text-sm font-semibold text-slate-300 mb-3 flex items-center gap-2">
            <Zap className="w-4 h-4 text-amber-400" /> Key Features
          </h3>
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
            {product.keyFeatures.map((feature, i) => (
              <div key={i} className="flex items-start gap-2 text-sm p-2 rounded-lg hover:bg-slate-700/20 transition-colors">
                <CheckCircle2 className="w-4 h-4 text-emerald-400 mt-0.5 shrink-0" />
                <span className="text-slate-300">{feature}</span>
              </div>
            ))}
          </div>
        </motion.section>

        {/* SECTION: System Flow */}
        <motion.section initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.7 }}
          className="rounded-xl border border-slate-700/50 bg-slate-800/40 backdrop-blur-sm p-5"
        >
          <h3 className="text-sm font-semibold text-slate-300 mb-3 flex items-center gap-2">
            <Activity className="w-4 h-4 text-emerald-400" /> System Flow
          </h3>
          <div className="relative pl-8">
            <div className="absolute left-3.5 top-2 bottom-2 w-0.5 bg-gradient-to-b from-emerald-400 via-violet-400 to-amber-400" />
            {variant.systemFlow.map((step, i) => {
              const stepColors: Record<string, string> = {
                input: 'bg-emerald-500', agent: 'bg-violet-500', process: 'bg-blue-500',
                memory: 'bg-amber-500', output: 'bg-rose-500', decision: 'bg-cyan-500',
              }
              return (
                <div key={step.id} className="relative mb-3 last:mb-0">
                  <div className={`absolute -left-5 top-1.5 w-4 h-4 rounded-full ${stepColors[step.type] || 'bg-slate-500'} flex items-center justify-center ring-2 ring-slate-900`}>
                    <span className="text-[8px] text-white font-bold">{i + 1}</span>
                  </div>
                  <div className="p-2.5 rounded-lg bg-slate-700/20 border border-slate-700/30">
                    <span className="font-semibold text-sm text-white">{step.label}</span>
                    <p className="text-xs text-slate-400">{step.description}</p>
                  </div>
                </div>
              )
            })}
          </div>
        </motion.section>
      </div>

      {/* SECTION 11: STICKY BUILD BAR */}
      <StickyBuildBar product={product} selectedTier={selectedTier} onExport={onExport} onGenerate={onGenerate} onBack={onBack} exporting={exporting} />
    </div>
  )
}

// ============================================================
// Knowledge Graph Tab Component
// ============================================================

function KnowledgeGraphTab({ nodes, edges, onBuild }: { nodes: KnowledgeGraphNode[]; edges: KnowledgeGraphEdge[]; onBuild: () => void }) {
  const [filter, setFilter] = useState<string>('all')

  const filteredNodes = useMemo(() => {
    if (filter === 'all') return nodes
    return nodes.filter(n => n.type === filter)
  }, [nodes, filter])

  const filteredEdges = useMemo(() => {
    if (filter === 'all') return edges
    return edges.filter(e => {
      const sourceNode = nodes.find(n => n.id === e.source)
      const targetNode = nodes.find(n => n.id === e.target)
      return sourceNode?.type === filter || targetNode?.type === filter
    })
  }, [edges, filter, nodes])

  const flowNodes: Node[] = useMemo(() => {
    return filteredNodes.map((node, index) => {
      const angle = (index / filteredNodes.length) * 2 * Math.PI
      const radius = 200 + (node.type === 'product' ? 0 : node.type === 'capability' ? 100 : 250)
      return {
        id: node.id,
        type: 'custom',
        position: { x: 400 + Math.cos(angle) * radius, y: 300 + Math.sin(angle) * radius },
        data: { label: node.label, nodeType: node.type },
      }
    })
  }, [filteredNodes])

  const flowEdges: Edge[] = useMemo(() => {
    return filteredEdges.map((edge) => ({
      id: edge.id,
      source: edge.source,
      target: edge.target,
      label: edge.label,
      type: 'smoothstep',
      animated: edge.type === 'provides',
      style: { stroke: edge.type === 'related' ? '#94a3b8' : edge.type === 'requires' ? '#8b5cf6' : '#3b82f6', strokeWidth: 1.5 },
      labelStyle: { fontSize: 10, fill: '#94a3b8' },
    }))
  }, [filteredEdges])

  if (nodes.length === 0) {
    return (
      <div className="flex flex-col items-center justify-center py-20">
        <Network className="w-16 h-16 text-slate-600 mb-4" />
        <h3 className="text-lg font-semibold text-white mb-2">Knowledge Graph</h3>
        <p className="text-slate-400 mb-4">Run &quot;Build Products&quot; to generate the knowledge graph</p>
        <Button onClick={onBuild} className="bg-gradient-to-r from-violet-500 to-indigo-600 text-white">
          <Brain className="w-4 h-4 mr-2" /> Build Products
        </Button>
      </div>
    )
  }

  return (
    <div className="space-y-3">
      {/* Filters + Legend */}
      <div className="flex items-center justify-between flex-wrap gap-3">
        <div className="flex items-center gap-2">
          <Filter className="w-4 h-4 text-slate-500" />
          {['all', 'repo', 'capability', 'product', 'tech', 'category'].map((type) => (
            <Button key={type} variant={filter === type ? 'default' : 'ghost'} size="sm"
              onClick={() => setFilter(type)}
              className={`h-7 text-xs ${filter === type ? 'bg-violet-600 text-white' : 'text-slate-400 hover:text-white'}`}>
              {type === 'all' ? 'All' : type.charAt(0).toUpperCase() + type.slice(1) + 's'}
            </Button>
          ))}
        </div>
        {/* Legend */}
        <div className="flex items-center gap-3 text-[10px] text-slate-500">
          {[
            { label: 'Repo', color: '#3b82f6' }, { label: 'Capability', color: '#8b5cf6' },
            { label: 'Product', color: '#10b981' }, { label: 'Tech', color: '#06b6d4' }, { label: 'Category', color: '#f59e0b' },
          ].map((item) => (
            <div key={item.label} className="flex items-center gap-1">
              <div className="w-2.5 h-2.5 rounded-full" style={{ backgroundColor: item.color }} />
              <span>{item.label}</span>
            </div>
          ))}
        </div>
      </div>

      {/* Graph */}
      <div className="rounded-xl border border-slate-700/50 bg-slate-800/40 backdrop-blur-sm overflow-hidden" style={{ height: 500 }}>
        <ReactFlow nodes={flowNodes} edges={flowEdges} nodeTypes={nodeTypes} fitView minZoom={0.3} maxZoom={2}
          proOptions={{ hideAttribution: true }}>
          <Background color="#334155" gap={20} />
          <Controls className="!bg-slate-800 !border-slate-700 [&>button]:!bg-slate-800 [&>button]:!border-slate-700 [&>button]:!text-slate-300 [&>button:hover]:!bg-slate-700" />
          <MiniMap
            nodeColor={(node) => getNodeColor((node.data as any)?.nodeType as string)}
            maskColor="rgba(0,0,0,0.3)"
            className="!bg-slate-800 !border-slate-700"
          />
        </ReactFlow>
      </div>
    </div>
  )
}

// ============================================================
// Main Component
// ============================================================

export default function Home() {
  const [activeTab, setActiveTab] = useState('explorer')
  const [repos, setRepos] = useState<RepoData[]>([])
  const [products, setProducts] = useState<ProductBuild[]>([])
  const [trends, setTrends] = useState<TrendData | null>(null)
  const [loading, setLoading] = useState(false)
  const [analyzing, setAnalyzing] = useState(false)
  const [language, setLanguage] = useState('')
  const [topic, setTopic] = useState('')
  const [since, setSince] = useState('weekly')
  const [searchQuery, setSearchQuery] = useState('')
  const [selectedProduct, setSelectedProduct] = useState<ProductBuild | null>(null)
  const [selectedTier, setSelectedTier] = useState<'simple' | 'intermediate' | 'advanced'>('intermediate')
  const [selectedRepos, setSelectedRepos] = useState<Set<number>>(new Set())
  const [viewMode, setViewMode] = useState<'grid' | 'list'>('grid')
  const [pipeline, setPipeline] = useState<PipelineStep[]>([])
  const [capabilities, setCapabilities] = useState<Capability[]>([])
  const [knowledgeNodes, setKnowledgeNodes] = useState<KnowledgeGraphNode[]>([])
  const [knowledgeEdges, setKnowledgeEdges] = useState<KnowledgeGraphEdge[]>([])
  const [exporting, setExporting] = useState(false)

  // Fetch trending repos
  const fetchRepos = useCallback(async () => {
    setLoading(true)
    try {
      const params = new URLSearchParams()
      if (language) params.set('language', language)
      if (topic) params.set('topic', topic)
      params.set('since', since)
      params.set('limit', '25')

      const res = await fetch(`/api/github/repos?${params}`)
      const data = await res.json()

      if (data.success) {
        setRepos(data.repos)
        toast.success(`Loaded ${data.count} trending repos`)
      } else {
        toast.error(data.error || 'Failed to fetch repos')
      }
    } catch {
      toast.error('Failed to fetch repos from GitHub')
    } finally {
      setLoading(false)
    }
  }, [language, topic, since])

  // Search repos
  const searchRepos = useCallback(async () => {
    if (!searchQuery.trim()) return
    setLoading(true)
    try {
      const params = new URLSearchParams()
      params.set('q', searchQuery)
      if (language) params.set('language', language)
      params.set('limit', '25')

      const res = await fetch(`/api/github/search?${params}`)
      const data = await res.json()

      if (data.success) {
        setRepos(data.repos)
        toast.success(`Found ${data.total_count?.toLocaleString()} repos`)
      } else {
        toast.error(data.error || 'Search failed')
      }
    } catch {
      toast.error('Search failed')
    } finally {
      setLoading(false)
    }
  }, [searchQuery, language])

  // Fetch trends
  const fetchTrends = useCallback(async () => {
    setLoading(true)
    try {
      const params = new URLSearchParams()
      if (language) params.set('language', language)
      if (topic) params.set('topic', topic)

      const res = await fetch(`/api/github/trends?${params}`)
      const data = await res.json()

      if (data.success) {
        setTrends(data.trends)
        toast.success('Trend analysis complete')
      }
    } catch {
      toast.error('Failed to analyze trends')
    } finally {
      setLoading(false)
    }
  }, [language, topic])

  // Run full agent analysis pipeline
  const runAnalysis = useCallback(async () => {
    if (repos.length === 0) {
      toast.error('Fetch some repos first!')
      return
    }
    setAnalyzing(true)
    setPipeline([
      { agent: 'Repo Analyzer', status: 'pending' },
      { agent: 'Capability Mapper', status: 'pending' },
      { agent: 'Product Generator', status: 'pending' },
      { agent: 'Architecture Designer', status: 'pending' },
    ])

    try {
      const res = await fetch('/api/github/analyze', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          repos: repos.map(r => ({
            name: r.name,
            description: r.description,
            stars: r.stars,
            language: r.language,
            topics: r.topics,
            category: r.category,
            trendScore: r.trendScore,
            growthRate: r.growthRate,
            innovationSignals: r.innovationSignals,
          })),
          focus: topic || undefined,
        }),
      })
      const data = await res.json()

      if (data.success) {
        setProducts(data.products || [])
        setCapabilities(data.capabilities || [])
        setPipeline(data.pipeline || [])
        setKnowledgeNodes(data.knowledgeGraph?.nodes || [])
        setKnowledgeEdges(data.knowledgeGraph?.edges || [])
        toast.success(`Generated ${data.products?.length || 0} AI product builds!`)
        setActiveTab('builder')
      } else {
        toast.error(data.error || 'Analysis failed')
      }
    } catch {
      toast.error('Agent analysis pipeline failed')
    } finally {
      setAnalyzing(false)
    }
  }, [repos, topic])

  // Export architecture
  const exportArchitecture = useCallback(async (product: ProductBuild, format: 'json' | 'yaml') => {
    setExporting(true)
    try {
      const res = await fetch('/api/github/export', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ product, format }),
      })
      if (!res.ok) throw new Error('Export failed')
      const blob = await res.blob()
      const url = URL.createObjectURL(blob)
      const a = document.createElement('a')
      a.href = url
      a.download = `${product.title.toLowerCase().replace(/\s+/g, '-')}-architecture.${format}`
      document.body.appendChild(a)
      a.click()
      document.body.removeChild(a)
      URL.revokeObjectURL(url)
      toast.success(`Exported as ${format.toUpperCase()}`)
    } catch {
      toast.error('Export failed')
    } finally {
      setExporting(false)
    }
  }, [])

  // Generate starter repo
  const generateStarterRepo = useCallback(async (product: ProductBuild, variant: string) => {
    try {
      const res = await fetch('/api/github/build', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ product, variant }),
      })
      const data = await res.json()
      if (data.success) {
        const blob = new Blob([JSON.stringify(data.scaffold, null, 2)], { type: 'application/json' })
        const url = URL.createObjectURL(blob)
        const a = document.createElement('a')
        a.href = url
        a.download = `${product.title.toLowerCase().replace(/\s+/g, '-')}-starter.json`
        document.body.appendChild(a)
        a.click()
        document.body.removeChild(a)
        URL.revokeObjectURL(url)
        toast.success('Starter repo scaffold generated!')
      }
    } catch {
      toast.error('Failed to generate starter repo')
    }
  }, [])

  // Toggle repo selection
  const toggleRepoSelection = useCallback((repoId: number) => {
    setSelectedRepos(prev => {
      const next = new Set(prev)
      if (next.has(repoId)) next.delete(repoId)
      else next.add(repoId)
      return next
    })
  }, [])

  // Auto-fetch on mount
  useEffect(() => {
    fetchRepos()
  }, [])

  // Pipeline status indicator
  const pipelineStatus = useMemo(() => {
    if (pipeline.length === 0) return 'idle'
    if (pipeline.some(s => s.status === 'error')) return 'error'
    if (pipeline.some(s => s.status === 'running')) return 'running'
    if (pipeline.every(s => s.status === 'completed')) return 'completed'
    return 'idle'
  }, [pipeline])

  // ============================================================
  // FULL SYSTEM VIEW
  // ============================================================
  if (selectedProduct) {
    return (
      <TooltipProvider>
        <div className="min-h-screen bg-slate-950">
          {/* Compact Header for System View */}
          <header className="sticky top-0 z-50 border-b border-slate-800/50 bg-slate-950/90 backdrop-blur-xl">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 py-2.5 flex items-center justify-between">
              <div className="flex items-center gap-3">
                <div className="w-8 h-8 rounded-lg bg-gradient-to-br from-violet-500 to-indigo-600 flex items-center justify-center">
                  <Rocket className="w-4 h-4 text-white" />
                </div>
                <div>
                  <h1 className="text-sm font-bold bg-gradient-to-r from-violet-400 to-indigo-400 bg-clip-text text-transparent">
                    AI Product Builder
                  </h1>
                </div>
              </div>
              <div className="flex items-center gap-2">
                {/* Pipeline Status Dots */}
                <div className="flex items-center gap-1 mr-2">
                  {pipeline.map((step, i) => (
                    <Tooltip key={step.agent}>
                      <TooltipTrigger>
                        <div className={`w-2 h-2 rounded-full ${
                          step.status === 'completed' ? 'bg-emerald-500' :
                          step.status === 'running' ? 'bg-violet-500 animate-pulse' :
                          step.status === 'error' ? 'bg-red-500' : 'bg-slate-600'
                        }`} />
                      </TooltipTrigger>
                      <TooltipContent>{step.agent}: {step.status}</TooltipContent>
                    </Tooltip>
                  ))}
                </div>
                <Button variant="ghost" size="sm" onClick={() => setSelectedProduct(null)} className="text-slate-400 hover:text-white">
                  <ArrowLeft className="w-4 h-4 mr-1" /> Back to Products
                </Button>
              </div>
            </div>
          </header>

          {/* System View Content */}
          <ScrollArea className="h-[calc(100vh-52px)]">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 py-6">
              <FullSystemView
                product={selectedProduct}
                selectedTier={selectedTier}
                onTierChange={setSelectedTier}
                onExport={exportArchitecture}
                onGenerate={generateStarterRepo}
                onBack={() => setSelectedProduct(null)}
                exporting={exporting}
                capabilities={capabilities}
              />
            </div>
          </ScrollArea>
        </div>
      </TooltipProvider>
    )
  }

  // ============================================================
  // MAIN DASHBOARD VIEW
  // ============================================================
  return (
    <TooltipProvider>
      <div className="min-h-screen bg-slate-950 flex flex-col">
        {/* TOP NAVIGATION */}
        <header className="sticky top-0 z-50 border-b border-slate-800/50 bg-slate-950/90 backdrop-blur-xl">
          <div className="max-w-7xl mx-auto px-4 sm:px-6 py-3">
            <div className="flex items-center justify-between gap-4">
              {/* Logo */}
              <div className="flex items-center gap-3 shrink-0">
                <div className="relative">
                  <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-violet-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-violet-500/25">
                    <Rocket className="w-5 h-5 text-white" />
                  </div>
                  <div className="absolute -top-1 -right-1 w-3.5 h-3.5 rounded-full bg-emerald-500 border-2 border-slate-950 flex items-center justify-center">
                    <Zap className="w-2 h-2 text-white" />
                  </div>
                </div>
                <div className="hidden sm:block">
                  <h1 className="text-lg font-bold bg-gradient-to-r from-violet-400 via-indigo-400 to-violet-400 bg-clip-text text-transparent">
                    AI Product Builder
                  </h1>
                  <p className="text-[10px] text-slate-500">Multi-Agent Architecture Engine</p>
                </div>
              </div>

              {/* Centered Search */}
              <div className="flex-1 max-w-xl hidden sm:flex items-center">
                <div className="relative w-full">
                  <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-500" />
                  <Input
                    placeholder="Search repos — ai-agent, rag framework, llm tools..."
                    value={searchQuery}
                    onChange={(e) => setSearchQuery(e.target.value)}
                    onKeyDown={(e) => e.key === 'Enter' && searchRepos()}
                    className="pl-9 h-9 bg-slate-900/80 border-slate-700/50 text-slate-200 placeholder:text-slate-600 focus:border-violet-500/50"
                  />
                </div>
              </div>

              {/* Right: Build CTA + Pipeline Status */}
              <div className="flex items-center gap-3 shrink-0">
                {/* Agent Pipeline Status Indicator */}
                <div className="flex items-center gap-1 px-2 py-1.5 rounded-lg bg-slate-900/50 border border-slate-800/50">
                  {pipeline.length > 0 ? (
                    pipeline.map((step, i) => (
                      <Tooltip key={step.agent}>
                        <TooltipTrigger>
                          <div className={`w-2.5 h-2.5 rounded-full transition-colors ${
                            step.status === 'completed' ? 'bg-emerald-500' :
                            step.status === 'running' ? 'bg-violet-500 animate-pulse' :
                            step.status === 'error' ? 'bg-red-500' : 'bg-slate-600'
                          }`} />
                        </TooltipTrigger>
                        <TooltipContent>{step.agent}: {step.status}</TooltipContent>
                      </Tooltip>
                    ))
                  ) : (
                    <>
                      <div className="w-2 h-2 rounded-full bg-slate-700" />
                      <div className="w-2 h-2 rounded-full bg-slate-700" />
                      <div className="w-2 h-2 rounded-full bg-slate-700" />
                      <div className="w-2 h-2 rounded-full bg-slate-700" />
                    </>
                  )}
                </div>

                <Button
                  onClick={runAnalysis}
                  disabled={analyzing || repos.length === 0}
                  className="bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 text-white shadow-lg shadow-violet-500/20 relative overflow-hidden group"
                >
                  {analyzing ? (
                    <><Loader2 className="w-4 h-4 mr-1.5 animate-spin" /> Analyzing...</>
                  ) : (
                    <>
                      <Brain className="w-4 h-4 mr-1.5" /> Build Products
                      <div className="absolute inset-0 bg-gradient-to-r from-violet-400/0 via-white/10 to-violet-400/0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700" />
                    </>
                  )}
                </Button>
              </div>
            </div>

            {/* Tabs Navigation */}
            <div className="mt-3 flex items-center gap-1">
              <button
                onClick={() => setActiveTab('explorer')}
                className={`px-3 py-1.5 rounded-md text-sm font-medium transition-colors flex items-center gap-1.5 ${
                  activeTab === 'explorer' ? 'bg-slate-800 text-white' : 'text-slate-500 hover:text-slate-300'
                }`}
              >
                <Compass className="w-4 h-4" /> Explorer
              </button>
              <button
                onClick={() => setActiveTab('builder')}
                className={`px-3 py-1.5 rounded-md text-sm font-medium transition-colors flex items-center gap-1.5 ${
                  activeTab === 'builder' ? 'bg-slate-800 text-white' : 'text-slate-500 hover:text-slate-300'
                }`}
              >
                <Rocket className="w-4 h-4" /> Builder
                {products.length > 0 && (
                  <span className="ml-1 px-1.5 py-0.5 rounded-full bg-violet-600 text-white text-[10px] font-bold">{products.length}</span>
                )}
              </button>
              <button
                onClick={() => setActiveTab('graph')}
                className={`px-3 py-1.5 rounded-md text-sm font-medium transition-colors flex items-center gap-1.5 ${
                  activeTab === 'graph' ? 'bg-slate-800 text-white' : 'text-slate-500 hover:text-slate-300'
                }`}
              >
                <Network className="w-4 h-4" /> Knowledge Graph
              </button>
              <button
                onClick={() => setActiveTab('saved')}
                className={`px-3 py-1.5 rounded-md text-sm font-medium transition-colors flex items-center gap-1.5 ${
                  activeTab === 'saved' ? 'bg-slate-800 text-white' : 'text-slate-500 hover:text-slate-300'
                }`}
              >
                <Bookmark className="w-4 h-4" /> Saved
              </button>
            </div>
          </div>
        </header>

        {/* Agent Pipeline Status Banner */}
        {analyzing && (
          <div className="max-w-7xl mx-auto px-4 sm:px-6 pt-4">
            <motion.div initial={{ opacity: 0, y: -10 }} animate={{ opacity: 1, y: 0 }}
              className="rounded-xl border border-violet-500/30 bg-violet-950/40 backdrop-blur-sm p-4">
              <div className="flex items-center gap-3 mb-3">
                <Brain className="w-5 h-5 text-violet-400 animate-pulse" />
                <span className="font-semibold text-violet-300 text-sm">Agent Pipeline Running</span>
              </div>
              <div className="flex items-center gap-2 flex-wrap">
                {pipeline.map((step, i) => (
                  <React.Fragment key={step.agent}>
                    <div className="flex items-center gap-2">
                      <div className={`w-6 h-6 rounded-full flex items-center justify-center text-xs ${
                        step.status === 'completed' ? 'bg-emerald-500 text-white' :
                        step.status === 'running' ? 'bg-violet-500 text-white animate-pulse' :
                        step.status === 'error' ? 'bg-red-500 text-white' :
                        'bg-slate-700 text-slate-400'
                      }`}>
                        {step.status === 'completed' ? <CheckCircle2 className="w-4 h-4" /> :
                         step.status === 'running' ? <Loader2 className="w-3 h-3 animate-spin" /> :
                         i + 1}
                      </div>
                      <span className={`text-xs font-medium ${
                        step.status === 'completed' ? 'text-emerald-400' :
                        step.status === 'running' ? 'text-violet-400' :
                        'text-slate-500'
                      }`}>{step.agent}</span>
                      {step.duration && (
                        <span className="text-[10px] text-slate-500">{step.duration}ms</span>
                      )}
                    </div>
                    {i < pipeline.length - 1 && <ArrowRight className="w-4 h-4 text-slate-700" />}
                  </React.Fragment>
                ))}
              </div>
            </motion.div>
          </div>
        )}

        {/* Main Content */}
        <main className="flex-1 max-w-7xl mx-auto px-4 sm:px-6 py-6 w-full">
          {/* Stats Bar */}
          <div className="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-6">
            {[
              { label: 'Repos Loaded', value: repos.length, icon: Github, color: 'from-violet-500 to-indigo-500' },
              { label: 'Products Built', value: products.length, icon: Rocket, color: 'from-emerald-500 to-teal-500' },
              { label: 'Capabilities', value: capabilities.length, icon: Layers, color: 'from-amber-500 to-orange-500' },
              { label: 'Categories', value: new Set(repos.map(r => r.category)).size, icon: Tag, color: 'from-rose-500 to-pink-500' },
              { label: 'Innovation', value: repos.reduce((acc, r) => acc + r.innovationSignals.length, 0), icon: Zap, color: 'from-cyan-500 to-sky-500' },
            ].map((stat, i) => (
              <motion.div key={stat.label} initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: i * 0.05 }}>
                <div className="rounded-xl border border-slate-800/50 bg-slate-900/50 backdrop-blur-sm p-4 hover:border-slate-700/50 transition-colors">
                  <div className="flex items-center gap-3">
                    <div className={`w-9 h-9 rounded-lg bg-gradient-to-br ${stat.color} flex items-center justify-center shadow-sm`}>
                      <stat.icon className="w-4.5 h-4.5 text-white" />
                    </div>
                    <div>
                      <p className="text-2xl font-bold text-white">{stat.value}</p>
                      <p className="text-[10px] text-slate-500">{stat.label}</p>
                    </div>
                  </div>
                </div>
              </motion.div>
            ))}
          </div>

          {/* ===================== EXPLORER TAB ===================== */}
          {activeTab === 'explorer' && (
            <div className="space-y-4">
              {/* Filters */}
              <div className="rounded-xl border border-slate-800/50 bg-slate-900/50 backdrop-blur-sm p-4">
                <div className="flex flex-wrap items-center gap-3">
                  <Filter className="w-4 h-4 text-slate-500" />
                  <Select value={language} onValueChange={setLanguage}>
                    <SelectTrigger className="w-[140px] h-8 text-xs bg-slate-800 border-slate-700 text-slate-300">
                      <SelectValue placeholder="Language" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="all">All Languages</SelectItem>
                      <SelectItem value="typescript">TypeScript</SelectItem>
                      <SelectItem value="python">Python</SelectItem>
                      <SelectItem value="rust">Rust</SelectItem>
                      <SelectItem value="go">Go</SelectItem>
                      <SelectItem value="javascript">JavaScript</SelectItem>
                    </SelectContent>
                  </Select>
                  <Input placeholder="Topic (e.g., machine-learning)" value={topic}
                    onChange={(e) => setTopic(e.target.value)}
                    className="w-[180px] h-8 text-xs bg-slate-800 border-slate-700 text-slate-300 placeholder:text-slate-600" />
                  <Select value={since} onValueChange={setSince}>
                    <SelectTrigger className="w-[120px] h-8 text-xs bg-slate-800 border-slate-700 text-slate-300">
                      <SelectValue placeholder="Time range" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="daily">Daily</SelectItem>
                      <SelectItem value="weekly">Weekly</SelectItem>
                      <SelectItem value="monthly">Monthly</SelectItem>
                    </SelectContent>
                  </Select>
                  <Button size="sm" onClick={fetchRepos} disabled={loading}
                    className="h-8 bg-violet-600 hover:bg-violet-500 text-white text-xs">Apply</Button>
                  {(language || topic) && (
                    <Button variant="ghost" size="sm" onClick={() => { setLanguage(''); setTopic('') }}
                      className="h-8 text-xs text-slate-400 hover:text-white">
                      <X className="w-3 h-3 mr-1" /> Clear
                    </Button>
                  )}
                  <div className="ml-auto flex items-center gap-1">
                    <Button variant={viewMode === 'grid' ? 'default' : 'ghost'} size="sm"
                      onClick={() => setViewMode('grid')}
                      className={`h-8 w-8 p-0 ${viewMode === 'grid' ? 'bg-slate-700 text-white' : 'text-slate-500'}`}>
                      <LayoutGrid className="w-4 h-4" />
                    </Button>
                    <Button variant={viewMode === 'list' ? 'default' : 'ghost'} size="sm"
                      onClick={() => setViewMode('list')}
                      className={`h-8 w-8 p-0 ${viewMode === 'list' ? 'bg-slate-700 text-white' : 'text-slate-500'}`}>
                      <List className="w-4 h-4" />
                    </Button>
                  </div>
                </div>
              </div>

              {/* Repo Grid */}
              {loading ? (
                <div className={`grid ${viewMode === 'grid' ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3' : 'grid-cols-1'} gap-3`}>
                  {Array.from({ length: 6 }).map((_, i) => (
                    <div key={i} className="rounded-xl border border-slate-800/50 bg-slate-900/50 p-4 space-y-3">
                      <Skeleton className="h-5 w-3/4 bg-slate-800" />
                      <Skeleton className="h-4 w-full bg-slate-800" />
                      <div className="flex gap-2"><Skeleton className="h-6 w-16 bg-slate-800" /><Skeleton className="h-6 w-16 bg-slate-800" /></div>
                    </div>
                  ))}
                </div>
              ) : repos.length === 0 ? (
                <div className="rounded-xl border border-slate-800/50 bg-slate-900/50 p-16 text-center">
                  <Github className="w-16 h-16 mx-auto text-slate-700 mb-4" />
                  <h3 className="text-lg font-semibold text-white mb-2">No Repos Loaded</h3>
                  <p className="text-slate-500 mb-4">Fetch trending repos to get started</p>
                  <Button onClick={fetchRepos} className="bg-violet-600 hover:bg-violet-500 text-white">
                    <RefreshCw className="w-4 h-4 mr-2" /> Fetch Trending Repos
                  </Button>
                </div>
              ) : (
                <motion.div className={`grid ${viewMode === 'grid' ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3' : 'grid-cols-1'} gap-3`} initial={false}>
                  <AnimatePresence mode="popLayout">
                    {repos.map((repo, index) => (
                      <motion.div key={repo.id} initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }}
                        exit={{ opacity: 0, scale: 0.95 }} transition={{ duration: 0.2, delay: index * 0.03 }} layout>
                        <RepoCard repo={repo} selected={selectedRepos.has(repo.id)} onToggleSelect={() => toggleRepoSelection(repo.id)} compact={viewMode === 'list'} />
                      </motion.div>
                    ))}
                  </AnimatePresence>
                </motion.div>
              )}

              {/* Trends inside Explorer */}
              {trends && (
                <div className="mt-6 space-y-4">
                  <div className="flex items-center justify-between">
                    <h3 className="text-lg font-semibold text-white flex items-center gap-2">
                      <BarChart3 className="w-5 h-5 text-violet-400" /> Trend Analysis
                    </h3>
                    <Button size="sm" variant="ghost" onClick={fetchTrends} disabled={loading} className="text-slate-400 hover:text-white text-xs">
                      <RefreshCw className={`w-3.5 h-3.5 mr-1 ${loading ? 'animate-spin' : ''}`} /> Refresh
                    </Button>
                  </div>
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {/* Top Languages */}
                    <div className="rounded-xl border border-slate-800/50 bg-slate-900/50 backdrop-blur-sm p-4">
                      <h4 className="text-sm font-semibold text-slate-300 mb-3 flex items-center gap-1.5">
                        <Code2 className="w-4 h-4 text-blue-400" /> Top Languages
                      </h4>
                      <div className="space-y-3">
                        {trends.topLanguages.slice(0, 8).map((lang) => (
                          <div key={lang.language} className="space-y-1">
                            <div className="flex items-center justify-between text-xs">
                              <div className="flex items-center gap-2">
                                <div className="w-3 h-3 rounded-full" style={{ backgroundColor: languageColors[lang.language] || '#6366f1' }} />
                                <span className="font-medium text-slate-300">{lang.language}</span>
                              </div>
                              <span className="text-slate-500">{lang.count} repos</span>
                            </div>
                            <div className="h-1.5 rounded-full bg-slate-800 overflow-hidden">
                              <div className="h-full rounded-full" style={{
                                width: `${(lang.count / (trends.topLanguages[0]?.count || 1)) * 100}%`,
                                backgroundColor: languageColors[lang.language] || '#6366f1'
                              }} />
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>

                    {/* Hot Categories */}
                    <div className="rounded-xl border border-slate-800/50 bg-slate-900/50 backdrop-blur-sm p-4">
                      <h4 className="text-sm font-semibold text-slate-300 mb-3 flex items-center gap-1.5">
                        <Layers className="w-4 h-4 text-emerald-400" /> Hot Categories
                      </h4>
                      <div className="space-y-2">
                        {trends.hotCategories.slice(0, 8).map((cat, i) => {
                          const total = trends.hotCategories.reduce((a, b) => a + b.count, 0)
                          const pct = Math.round((cat.count / total) * 100)
                          return (
                            <div key={cat.name} className="flex items-center gap-3">
                              <Badge className={getCategoryColor(cat.name)}>{cat.name}</Badge>
                              <div className="flex-1 h-1.5 bg-slate-800 rounded-full overflow-hidden">
                                <motion.div className="h-full rounded-full bg-gradient-to-r from-emerald-400 to-teal-500"
                                  initial={{ width: 0 }} animate={{ width: `${pct}%` }} transition={{ duration: 0.5, delay: i * 0.1 }} />
                              </div>
                              <span className="text-xs text-slate-500 w-10 text-right">{pct}%</span>
                            </div>
                          )
                        })}
                      </div>
                    </div>

                    {/* Trending Topics */}
                    <div className="rounded-xl border border-slate-800/50 bg-slate-900/50 backdrop-blur-sm p-4">
                      <h4 className="text-sm font-semibold text-slate-300 mb-3 flex items-center gap-1.5">
                        <Tag className="w-4 h-4 text-purple-400" /> Trending Topics
                      </h4>
                      <div className="flex flex-wrap gap-2">
                        {trends.topTopics.slice(0, 20).map((t) => (
                          <Tooltip key={t.topic}>
                            <TooltipTrigger>
                              <Badge variant="outline" className="cursor-default text-xs border-slate-700 text-slate-300 hover:border-violet-500/50 hover:text-violet-300 transition-colors">
                                {t.topic} <span className="ml-1 text-slate-500">({t.count})</span>
                              </Badge>
                            </TooltipTrigger>
                            <TooltipContent>Growth: +{t.growth}%</TooltipContent>
                          </Tooltip>
                        ))}
                      </div>
                    </div>

                    {/* Key Insights */}
                    <div className="rounded-xl border border-slate-800/50 bg-slate-900/50 backdrop-blur-sm p-4">
                      <h4 className="text-sm font-semibold text-slate-300 mb-3 flex items-center gap-1.5">
                        <Brain className="w-4 h-4 text-rose-400" /> Key Insights
                      </h4>
                      <div className="space-y-3">
                        {trends.insights.map((insight, i) => (
                          <div key={i} className="flex items-start gap-3 p-2.5 rounded-lg bg-slate-800/50">
                            <div className="w-5 h-5 rounded-full bg-gradient-to-br from-rose-400 to-pink-500 flex items-center justify-center shrink-0 mt-0.5">
                              <span className="text-[9px] text-white font-bold">{i + 1}</span>
                            </div>
                            <p className="text-xs text-slate-400">{insight}</p>
                          </div>
                        ))}
                        {trends.emergingTech.length > 0 && (
                          <div className="p-3 rounded-lg bg-amber-950/30 border border-amber-700/30">
                            <p className="text-xs font-medium text-amber-300 flex items-center gap-1.5 mb-2">
                              <Flame className="w-3.5 h-3.5" /> Emerging Technologies
                            </p>
                            <div className="flex flex-wrap gap-1.5">
                              {trends.emergingTech.map((tech) => (
                                <Badge key={tech} className="bg-amber-900/40 text-amber-300 border-0 text-[10px]">{tech}</Badge>
                              ))}
                            </div>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              )}

              {/* Load Trends Button */}
              {!trends && repos.length > 0 && (
                <div className="mt-4 text-center">
                  <Button variant="outline" onClick={fetchTrends} disabled={loading}
                    className="border-slate-700 text-slate-400 hover:text-white hover:border-slate-600">
                    <TrendingUp className="w-4 h-4 mr-2" /> Analyze Trends
                  </Button>
                </div>
              )}
            </div>
          )}

          {/* ===================== BUILDER TAB ===================== */}
          {activeTab === 'builder' && (
            <div className="space-y-4">
              {products.length === 0 ? (
                <div className="rounded-xl border border-slate-800/50 bg-slate-900/50 backdrop-blur-sm p-16 text-center">
                  <div className="w-20 h-20 rounded-2xl bg-gradient-to-br from-violet-500 to-indigo-600 flex items-center justify-center mx-auto mb-4 shadow-lg shadow-violet-500/25">
                    <Rocket className="w-10 h-10 text-white" />
                  </div>
                  <h3 className="text-xl font-bold text-white mb-2">AI Product Builder</h3>
                  <p className="text-slate-400 mb-6 max-w-md mx-auto">
                    Load trending repos and click &quot;Build Products&quot; to run the multi-agent pipeline.
                    Get architecture, build variants, and system flow.
                  </p>
                  <div className="flex items-center justify-center gap-3">
                    <Button onClick={fetchRepos} disabled={loading} variant="outline"
                      className="border-slate-700 text-slate-300 hover:text-white hover:border-slate-600">
                      <Github className="w-4 h-4 mr-2" /> Load Repos
                    </Button>
                    <Button onClick={runAnalysis} disabled={analyzing || repos.length === 0}
                      className="bg-gradient-to-r from-violet-600 to-indigo-600 text-white shadow-lg shadow-violet-500/20">
                      <Brain className="w-4 h-4 mr-2" /> Build Products
                    </Button>
                  </div>
                  {/* Pipeline preview */}
                  <div className="mt-8 flex items-center justify-center gap-2 text-xs text-slate-600">
                    {['Repo Analyzer', 'Capability Mapper', 'Product Generator', 'Architecture Designer'].map((agent, i) => (
                      <React.Fragment key={agent}>
                        <span className="px-3 py-1.5 rounded-full bg-slate-800/50 border border-slate-700/30">{agent}</span>
                        {i < 3 && <ArrowRight className="w-4 h-4 text-slate-700" />}
                      </React.Fragment>
                    ))}
                  </div>
                </div>
              ) : (
                <>
                  {/* Capabilities Summary */}
                  {capabilities.length > 0 && (
                    <div className="rounded-xl border border-slate-800/50 bg-slate-900/50 backdrop-blur-sm p-4">
                      <h3 className="text-sm font-semibold text-slate-300 mb-3 flex items-center gap-2">
                        <Layers className="w-4 h-4 text-violet-400" /> Detected Capabilities
                      </h3>
                      <div className="flex flex-wrap gap-2">
                        {capabilities.map((cap) => {
                          const CapIcon = getCapabilityIcon(cap.category)
                          return (
                            <Tooltip key={cap.category}>
                              <TooltipTrigger>
                                <Badge className={`${getCapabilityBgColor(cap.category)} border cursor-default text-xs`}>
                                  <CapIcon className="w-3 h-3 mr-1.5" />
                                  {cap.label}
                                  <span className="ml-1.5 text-slate-500">({cap.repos.length})</span>
                                </Badge>
                              </TooltipTrigger>
                              <TooltipContent className="max-w-xs">{cap.description}</TooltipContent>
                            </Tooltip>
                          )
                        })}
                      </div>
                    </div>
                  )}

                  {/* Product Cards Grid */}
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {products.map((product, index) => (
                      <motion.div key={product.title + index}
                        initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }}
                        transition={{ duration: 0.3, delay: index * 0.05 }}>
                        <ProductCard product={product} onSelect={() => { setSelectedProduct(product); setSelectedTier('intermediate') }} />
                      </motion.div>
                    ))}
                  </div>
                </>
              )}
            </div>
          )}

          {/* ===================== KNOWLEDGE GRAPH TAB ===================== */}
          {activeTab === 'graph' && (
            <KnowledgeGraphTab nodes={knowledgeNodes} edges={knowledgeEdges} onBuild={runAnalysis} />
          )}

          {/* ===================== SAVED TAB ===================== */}
          {activeTab === 'saved' && (
            <div className="rounded-xl border border-slate-800/50 bg-slate-900/50 backdrop-blur-sm p-16 text-center">
              <Bookmark className="w-16 h-16 mx-auto text-slate-700 mb-4" />
              <h3 className="text-lg font-semibold text-white mb-2">Saved Products</h3>
              <p className="text-slate-500 mb-4">Your saved AI product builds will appear here</p>
              <Button variant="outline" onClick={() => setActiveTab('builder')}
                className="border-slate-700 text-slate-300 hover:text-white hover:border-slate-600">
                <Rocket className="w-4 h-4 mr-2" /> Go to Builder
              </Button>
            </div>
          )}
        </main>

        {/* Footer */}
        <footer className="mt-auto py-4 border-t border-slate-800/50">
          <div className="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between text-xs text-slate-600">
            <div className="flex items-center gap-2">
              <Rocket className="w-3.5 h-3.5" />
              <span>AI Product Builder — Multi-Agent Architecture Engine</span>
            </div>
            <div className="flex items-center gap-4">
              <span>Powered by MCP + 4 Agent Pipeline</span>
              <span className="flex items-center gap-1"><Sparkles className="w-3 h-3 text-amber-600" /> AI-Native</span>
            </div>
          </div>
        </footer>
      </div>
    </TooltipProvider>
  )
}
