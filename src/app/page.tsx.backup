function RepoFlowNode({ data }: NodeProps) {
  const catColor: Record<string, string> = {
    memory: 'border-violet-500/60 bg-violet-950/80',
    agent: 'border-amber-500/60 bg-amber-950/80',
    rag: 'border-emerald-500/60 bg-emerald-950/80',
    ui: 'border-blue-500/60 bg-blue-950/80',
    automation: 'border-rose-500/60 bg-rose-950/80',
    'model-serving': 'border-indigo-500/60 bg-indigo-950/80',
    data: 'border-orange-500/60 bg-orange-950/80',
    security: 'border-red-500/60 bg-red-950/80',
    infra: 'border-slate-500/60 bg-slate-950/80',
    communication: 'border-cyan-500/60 bg-cyan-950/80',
  }
  const bg = catColor[data.repoCategory as string] || 'border-gray-500/60 bg-gray-950/80'
  const repoCategory = data.repoCategory as string || ''

  return (
    <div className={`px-3 py-2.5 rounded-lg border shadow-xl backdrop-blur-sm min-w-[140px] ${bg}`}>
      <Handle type="target" position={Position.Top} className="!bg-slate-400 !w-2 !h-2" />
      <div className="flex items-center gap-2 mb-1">
        <CapabilityIconRenderer category={repoCategory} className="w-4 h-4 text-slate-300 shrink-0" />
        <span className="text-xs font-semibold text-white truncate max-w-[120px]">{data.label as string}</span>
      </div>
      {data.repoRole && (
        <div className="text-[10px] text-slate-400 ml-6">{data.repoRole as string}</div>
      )}
      <Handle type="source" position={Position.Bottom} className="!bg-slate-400 !w-2 !h-2" />
    </div>
  )
}

const nodeTypes: NodeTypes = {
  custom: CustomFlowNode,
