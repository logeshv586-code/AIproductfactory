const getTierColor = (tier: string) => {
  switch (tier) {
    case 'simple': return { bg: 'bg-emerald-50 border-emerald-300 dark:bg-emerald-900/20 dark:border-emerald-700', badge: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300', dot: 'bg-emerald-500', text: 'text-emerald-600 dark:text-emerald-400', border: 'border-emerald-500' }
    case 'intermediate': return { bg: 'bg-amber-50 border-amber-300 dark:bg-amber-900/20 dark:border-amber-700', badge: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300', dot: 'bg-amber-500', text: 'text-amber-600 dark:text-amber-400', border: 'border-amber-500' }
    case 'advanced': return { bg: 'bg-rose-50 border-rose-300 dark:bg-rose-900/20 dark:border-rose-700', badge: 'bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300', dot: 'bg-rose-500', text: 'text-rose-600 dark:text-rose-400', border: 'border-rose-500' }
    default: return { bg: 'bg-gray-50 border-gray-300', badge: 'bg-gray-100 text-gray-800', dot: 'bg-gray-500', text: 'text-gray-600', border: 'border-gray-500' }
  }
}

const getArchBlockColor = (type: string) => {
  const colors: Record<string, string> = {
    frontend: 'from-sky-400 to-blue-500',
    api: 'from-emerald-400 to-teal-500',
    agent: 'from-amber-400 to-orange-500',
    memory: 'from-violet-400 to-purple-500',
    llm: 'from-indigo-400 to-violet-500',
    data: 'from-orange-400 to-red-500',
    infra: 'from-slate-400 to-gray-500',
    service: 'from-cyan-400 to-sky-500',
    automation: 'from-rose-400 to-pink-500',
  }
  return colors[type] || 'from-gray-400 to-slate-500'
}

const getArchBlockBgColor = (type: string) => {
  const colors: Record<string, string> = {
    frontend: 'bg-sky-500/10 border-sky-500/30',
    api: 'bg-emerald-500/10 border-emerald-500/30',
    agent: 'bg-amber-500/10 border-amber-500/30',
    memory: 'bg-violet-500/10 border-violet-500/30',
    llm: 'bg-indigo-500/10 border-indigo-500/30',
    data: 'bg-orange-500/10 border-orange-500/30',
    infra: 'bg-slate-500/10 border-slate-500/30',
    service: 'bg-cyan-500/10 border-cyan-500/30',
    automation: 'bg-rose-500/10 border-rose-500/30',
  }
  return colors[type] || 'bg-gray-500/10 border-gray-500/30'
}

const formatStars = (n: number): string => {
  if (n >= 1000) return `${(n / 1000).toFixed(1)}k`
  return n.toString()
}

const getScoreColor = (score: number): string => {
  if (score >= 8) return '#10b981'
  if (score >= 6) return '#f59e0b'
  if (score >= 4) return '#f97316'
  return '#ef4444'
}

const getNodeColor = (type: string): string => {
  const colors: Record<string, string> = {
    repo: '#3b82f6', capability: '#8b5cf6', product: '#10b981', tech: '#06b6d4', category: '#f59e0b',
  }
  return colors[type] || '#6366f1'
}

