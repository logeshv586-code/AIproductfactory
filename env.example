DATABASE_URL=file:./db/custom.db

# Next.js <-> Python Product Intelligence backend
PYTHON_BACKEND_URL=http://localhost:8001
PYTHON_BACKEND_PORT=8001

# LLM provider mode
# auto = try every configured provider in LLM_PROVIDER_ORDER, then local fallback.
# Explicit values: deepseek | nvidia | openai | anthropic | claude | gemini | local
LLM_PROVIDER=auto
LLM_PROVIDER_ORDER=deepseek,nvidia,openai,anthropic,gemini

# Kept for compatibility with any Next-side/default provider selectors.
DEFAULT_LLM_PROVIDER=auto
DEFAULT_LLM_MODEL=

# DeepSeek (Official API)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Optional: custom Anthropic-compatible gateway. Leave empty for Anthropic API.
ANTHROPIC_BASE_URL=

# Google Gemini (Google GenAI SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# NVIDIA NIM / hosted OpenAI-compatible endpoint
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Leave blank for maximum model compatibility. Set 1/0 only when the selected
# NVIDIA model supports chat_template_kwargs.enable_thinking.
NVIDIA_THINKING=

# GitHub + external research
# Set GITHUB_TOKEN for higher GitHub API limits and richer repository discovery.
GITHUB_TOKEN=
TAVILY_API_KEY=

# Factory quality gate
MIN_ACCEPTABLE_PRODUCT_SCORE=0.4
