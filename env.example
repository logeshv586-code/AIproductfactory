DATABASE_URL=file:./db/custom.db

# Next.js <-> Python Product Intelligence backend
PYTHON_BACKEND_URL=http://localhost:8001
PYTHON_BACKEND_PORT=8001

# LLM Provider Configuration
# python-backend/llm/provider.py reads LLM_PROVIDER.
LLM_PROVIDER=nvidia
# Kept for compatibility with any Next-side/default provider selectors.
DEFAULT_LLM_PROVIDER=nvidia
DEFAULT_LLM_MODEL=deepseek-ai/deepseek-v4-pro

# GitHub + external research
# Set GITHUB_TOKEN for higher GitHub API limits and richer repository discovery.
GITHUB_TOKEN=
TAVILY_API_KEY=

# API Keys (configure only the providers you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# NVIDIA configuration
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_THINKING=1

# Factory quality gate
MIN_ACCEPTABLE_PRODUCT_SCORE=0.4
